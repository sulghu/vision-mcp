# 复制为环境变量（Node 不自动读 .env，请在你的 shell 或 MCP 客户端 env 里设置）

# 必填：你的 API Key（阿里云百炼 DashScope 或任何 OpenAI 兼容供应商）
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：OpenAI 兼容端点，默认 https://dashscope.aliyuncs.com/compatible-mode/v1
# 例：OpenAI 官方  https://api.openai.com/v1       模型 gpt-4o / gpt-4o-mini
#     硅基流动    https://api.siliconflow.cn/v1     模型 Qwen/Qwen2.5-VL-72B-Instruct
#VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#VISION_MODEL=qwen3.7-plus
#VISION_TIMEOUT=120000
#VISION_MAX_TOKENS=1024
# 深度思考开关：false 不开启（默认），true 开启
#VISION_ENABLE_THINKING=false
